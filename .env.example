# MediFlow backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# NEVER commit the real .env file with actual keys.

# Primary map provider (Geoapify)
VITE_GEOAPIFY_API_KEY=

# Fallback map provider (LocationIQ)
VITE_LOCATIONIQ_API_KEY=

# Geoapify daily safety limit (must stay below published 3000 credits/day)
VITE_GEOAPIFY_DAILY_SAFETY_LIMIT=2800

# LocationIQ daily safety limit (must stay below published 5000 requests/day)
VITE_LOCATIONIQ_DAILY_SAFETY_LIMIT=4500

# Default map tile style: positron, dark-matter, osm-carto, klokantech-basic
VITE_MAP_TILE_STYLE=positron

# Default hospital search radius in meters
VITE_HOSPITAL_SEARCH_RADIUS_M=10000

# Maximum search radius in meters
VITE_HOSPITAL_SEARCH_MAX_RADIUS_M=30000

# Minimum hospitals required before expanding radius
VITE_HOSPITAL_MIN_RESULTS=5

# Route cache TTL in seconds
VITE_ROUTE_CACHE_TTL=600

# Search cache TTL in seconds
VITE_SEARCH_CACHE_TTL=300

# Nearby cache TTL in seconds
VITE_NEARBY_CACHE_TTL=600

# Enable public OSRM demo server as LAST resort routing fallback.
# WARNING: public OSRM demo is rate-limited and NOT for production use.
# Keep false in production. Enable only for SIH demo/dev if explicitly needed.
VITE_ENABLE_OSRM_DEMO_FALLBACK=false

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
